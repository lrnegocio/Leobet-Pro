
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a user (Admin, Cambista, or Cliente)",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "cambista", "cliente"] },
        "balance": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "cpf": { "type": "string" },
        "pixKey": { "type": "string" },
        "phone": { "type": "string" },
        "commissionRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "email", "role", "balance", "status"]
    },
    "Bingo": {
      "title": "Bingo Game",
      "description": "A bingo draw event",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "preco": { "type": "number" },
        "totalCartelas": { "type": "number" },
        "vendidas": { "type": "number" },
        "vendidasCambista": { "type": "number" },
        "dataSorteio": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["aberto", "sorteio", "encerrado"] },
        "bolasSorteadas": { "type": "array", "items": { "type": "number" } },
        "regras": { "type": "string" },
        "whatsapp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "preco", "status", "dataSorteio"]
    },
    "Bolao": {
      "title": "Bolão Esportivo / Numérico",
      "description": "A pool game (soccer or lottery numbers)",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "preco": { "type": "number" },
        "status": { "type": "string", "enum": ["aberto", "encerrado", "finalizado"] },
        "tipo": { "type": "string", "enum": ["esportivo", "mega", "quina"] },
        "data_fim": { "type": "string", "format": "date-time" },
        "partidas": { "type": "array" },
        "drawn_numbers": { "type": "array" },
        "scores": { "type": "array" },
        "max_hits": { "type": "number" },
        "regras": { "type": "string" },
        "vendidas": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "preco", "status", "tipo"]
    },
    "Ticket": {
      "title": "Bingo/Bolao Ticket",
      "description": "A ticket sold for an event",
      "type": "object",
      "properties": {
        "evento_id": { "type": "string" },
        "evento_nome": { "type": "string" },
        "tipo": { "type": "string" },
        "cliente": { "type": "string" },
        "whatsapp": { "type": "string" },
        "pix_resgate": { "type": "string" },
        "valor_total": { "type": "number" },
        "vendedor_id": { "type": "string" },
        "status": { "type": "string" },
        "tickets_data": { "type": "array" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "User profiles" },
    "/bingos/{bingoId}": { "schema": "Bingo", "description": "Bingo games" },
    "/boloes/{bolaoId}": { "schema": "Bolao", "description": "Bolão games" },
    "/tickets/{ticketId}": { "schema": "Ticket", "description": "Sold tickets" }
  }
}
